# Public site settings. Keep preview mode until feeds, policies, and legal pages are ready.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_MODE=preview
DEPLOYMENT_VERSION=local

# Affiliate links are resolved in this order:
#   1. AFFILIATE_URL_<OFFER_ID>      one specific offer
#   2. AFFILIATE_TEMPLATE_<SELLER>   every offer for that seller
# Placeholders: {{url}} {{url_encoded}} {{click_id}}
# Run the dev server and open /api/affiliate-template for a generated file.
#
# Wrapper networks redirect via their own domain, so allow those hosts here.
AFFILIATE_NETWORK_DOMAINS=

# Wrapper style, e.g. most Indian cashback/affiliate networks:
# AFFILIATE_TEMPLATE_MYNTRA=https://network.example/r?id=YOURID&url={{url_encoded}}&subid={{click_id}}

# Parameter style, appended to the seller's own URL:
# AFFILIATE_TEMPLATE_AMAZON={{url}}&tag=YOURTAG-21

# The example below is not monetized. Replace the complete URL only after an
# approved network provides the exact Flipkart deep link and tracking parameters.
AFFILIATE_URL_OFFER_REV7_FLIPKART=https://www.flipkart.com/search?q=Nike%20Revolution%207

# Some networks support a sub-ID query parameter for conversion reconciliation.
# Put {{click_id}} in that network's documented sub-ID field and the redirect route
# will replace it with the generated click ID. Do not add unsupported parameters.
# AFFILIATE_URL_OFFER_WOF_AMAZON=https://www.amazon.in/s?k=9788173711466&approved_subid={{click_id}}